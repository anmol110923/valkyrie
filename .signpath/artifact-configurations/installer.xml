<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer".
  Input: a zip containing the NSIS installer Valkyrie-<version>-win-<arch>.exe built from the
  already-signed app files.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="Valkyrie-*-win-*.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
